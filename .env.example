# Copy to .env and fill in real values. .env is gitignored.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-64
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Database (shared with wenda-quiz) ----
DB_ENGINE=django.db.backends.mysql
DB_NAME=wenda_db
DB_USER=wenda
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Channels (leave empty for in-memory dev; set for prod) ----
# Example for prod: CHANNEL_REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=
