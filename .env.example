# Copy to .env and fill in real values. .env is gitignored.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-64
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed for HTTPS or cross-origin POSTs. Local HTTP dev (any port, e.g.
# running this app on :8001 alongside wenda-quiz on :8000) does NOT need it.
# For prod, list scheme+host(+port), comma-separated, e.g.:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://live.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTP Strict Transport Security. Leave at 0 until the whole domain is HTTPS —
# it's effectively irreversible for its lifetime. This app shares a domain with
# wenda-quiz, so only enable include-subdomains/preload deliberately.
#   DJANGO_HSTS_SECONDS=31536000   # 1 year, once you're sure
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
# Dev server bind (wenda-quiz uses 8000); `manage.py runserver` defaults to these.
# Host 0.0.0.0 = listen on all interfaces so another machine (e.g. a test VM)
# can reach it; 127.0.0.1 keeps it local-only.
DJANGO_RUNSERVER_HOST=127.0.0.1
DJANGO_RUNSERVER_PORT=8001

# ---- Database (shared with wenda-quiz) ----
DB_ENGINE=django.db.backends.mysql
DB_NAME=wenda_db
DB_USER=wenda
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Channels (leave empty for in-memory dev; set for prod) ----
# Example for prod: CHANNEL_REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=
